{
  "name": "Minutes",
  "type": "object",
  "properties": {
    "meetingId": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "content": {
      "type": "string"
    },
    "structuredData": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "em_revisao",
        "aguardando_aprovacao",
        "aprovada",
        "rejeitada"
      ]
    },
    "generatedBy": {
      "type": "string",
      "enum": [
        "ia",
        "humano",
        "ia_com_edicao_humana"
      ]
    },
    "templateId": {
      "type": "string",
      "description": "Template pr\u00f3prio usado na gera\u00e7\u00e3o (vazio para modelos padr\u00e3o)"
    },
    "templateName": {
      "type": "string",
      "description": "Nome do template usado na gera\u00e7\u00e3o, para rastreabilidade"
    },
    "reviewedByUserId": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvedByUserId": {
      "type": "string"
    }
  },
  "required": [
    "meetingId",
    "version",
    "content",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}