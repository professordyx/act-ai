{
  "name": "Approval",
  "type": "object",
  "properties": {
    "meetingId": {
      "type": "string"
    },
    "minutesId": {
      "type": "string"
    },
    "minutesVersion": {
      "type": "integer"
    },
    "approverUserId": {
      "type": "string"
    },
    "approverName": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "aprovado",
        "rejeitado"
      ]
    },
    "comment": {
      "type": "string"
    },
    "contentHash": {
      "type": "string",
      "description": "SHA-256 do conte\u00fado da ata no momento da decis\u00e3o"
    }
  },
  "required": [
    "meetingId",
    "minutesId",
    "approverUserId",
    "decision"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}