{
  "name": "MinutesTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es de formato aplicadas \u00e0 gera\u00e7\u00e3o da ata"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "createdByEmail": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "prompt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}