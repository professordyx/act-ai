      "type": "string"
    },
    "eventDescription": {
      "type": "string"
    },
    "oldValueJson": {
      "type": "string"
    },
    "newValueJson": {
      "type": "string"
    },
    "performedByUserId": {
      "type": "string"
    },
    "performedByName": {
      "type": "string"
    },
