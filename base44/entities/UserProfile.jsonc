{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "admin",
          "organizer",
          "reviewer",
          "approver",
          "participant",
          "auditor"
        ]
      }
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "hasPaidSeat": {
      "type": "boolean",
      "default": false,
      "description": "Usu\u00e1rio ocupa um dos assentos pagos da empresa (definido pelo administrador)"
    },
    "seatAssignedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "roles"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}