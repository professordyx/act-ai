{
  "name": "AiUsage",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "ata",
        "acoes",
        "traducao",
        "idioma"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "gray"
      ],
      "description": "Tipo de uso da IA"
    },
    "model": {
      "type": "string",
      "description": "Modelo solicitado (automatic = padr\u00e3o da plataforma)"
    },
    "meetingId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string"
    },
    "inputChars": {
      "type": "number"
    },
    "outputChars": {
      "type": "number"
    },
    "inputTokens": {
      "type": "number",
      "description": "Estimativa: caracteres / 4"
    },
    "outputTokens": {
      "type": "number",
      "description": "Estimativa: caracteres / 4"
    },
    "costUsd": {
      "type": "number",
      "description": "Custo estimado em d\u00f3lar (tabela de refer\u00eancia de pre\u00e7os por 1M de tokens)"
    }
  },
  "required": [
    "kind",
    "inputTokens",
    "outputTokens",
    "costUsd"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}